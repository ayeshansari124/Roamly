<section class="max-w-7xl mx-auto px-4 sm:px-6 pt-8">

  <div class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between">

    <div class="w-full max-w-2xl">

      <h1 class="text-3xl sm:text-4xl font-black text-gray-900 leading-tight">
        Explore Experiences
      </h1>

      <p class="mt-2 text-sm sm:text-base text-gray-500">
        Hand-picked trips, local tours, and unforgettable travel moments.
      </p>

      <form
        method="GET"
        action="/explore"
        class="mt-6 flex overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm"
      >

        <input
          type="text"
          name="q"
          value="<%= query || '' %>"
          placeholder="Search destinations, tours, experiences..."
          class="w-full px-5 py-3.5 text-sm sm:text-base outline-none"
        >

        <button
          type="submit"
          class="px-6 bg-yellow-400 hover:bg-yellow-500 text-black font-bold transition"
        >
          Search
        </button>

      </form>

    </div>

    <% if (userRole === "admin") { %>

      <a
        href="/admin/add-experience"
        class="inline-flex items-center justify-center px-5 py-3 bg-black hover:bg-zinc-800 text-white font-semibold rounded-2xl shadow-sm transition"
      >
        + Add Experience
      </a>

    <% } %>

  </div>

</section>

<section class="max-w-7xl mx-auto px-4 sm:px-6 mt-10 pb-14">

  <% if (experiences.length === 0) { %>

    <div class="py-24 text-center">

      <h2 class="text-2xl font-bold text-gray-800">
        No experiences found
      </h2>

      <% if (query) { %>

        <p class="mt-2 text-gray-500">
          No results for
          <span class="font-semibold text-black">"<%= query %>"</span>
        </p>

      <% } %>

    </div>

  <% } %>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">

    <% experiences.forEach(exp => { %>

      <div
        class="group relative overflow-hidden bg-white border border-gray-200 rounded-3xl hover:shadow-2xl hover:-translate-y-1 transition duration-300"
      >

        <!-- IMAGE -->
        <a href="/experience/<%= exp._id %>" class="block relative overflow-hidden">

          <img
            src="<%= exp.image %>"
            class="w-full h-64 object-cover group-hover:scale-105 transition duration-500"
          >

          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>

          <!-- PRICE -->
          <span class="absolute top-4 right-4 px-4 py-1.5 bg-white/95 backdrop-blur text-sm font-bold text-black rounded-full shadow">
            ₹<%= exp.price %>
          </span>

          <!-- LOCATION -->
          <span class="absolute bottom-4 left-4 px-3 py-1 bg-black/60 backdrop-blur text-xs text-white rounded-full">
            <%= exp.location %>
          </span>

        </a>

        <!-- ADMIN CONTROLS -->
        <% if (userRole === "admin") { %>

          <div class="absolute top-4 left-4 z-20 flex items-center gap-2">

            <!-- EDIT -->
            <a
              href="/admin/edit-experience/<%= exp._id %>"
              onclick="event.stopPropagation()"
              class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/90 backdrop-blur border border-white/60 text-blue-600 hover:bg-blue-50 transition shadow-sm"
            >

              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M11 5h2m-7 14h12a2 2 0 002-2V7a2 2 0 00-2-2H6a2 2 0 00-2 2v10a2 2 0 002 2zm10-13l-1-1a2.121 2.121 0 00-3 0l-7 7v3h3l7-7a2.121 2.121 0 000-3z"
                />
              </svg>

            </a>

            <!-- DELETE -->
            <form
              method="POST"
              action="/admin/delete-experience/<%= exp._id %>"
              onsubmit="event.stopPropagation(); return confirm('Delete this experience?');"
            >

              <button
                type="submit"
                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white/90 backdrop-blur border border-white/60 text-red-600 hover:bg-red-50 transition shadow-sm"
              >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6M9 7V4a1 1 0 011-1h4a1 1 0 011 1v3m-7 0h8"
                  />
                </svg>

              </button>

            </form>

          </div>

        <% } %>

        <!-- CONTENT -->
        <div class="p-5">

          <a href="/experience/<%= exp._id %>">

            <h3 class="text-xl font-bold text-gray-900 leading-snug group-hover:text-yellow-600 transition">
              <%= exp.title %>
            </h3>

            <p class="mt-3 text-sm leading-6 text-gray-600 line-clamp-2">
              <%= exp.description %>
            </p>

            <div class="flex items-center justify-between pt-5">

              <div class="flex items-center gap-2 text-sm text-gray-500">
                <span class="text-base">⏱</span>
                <span><%= exp.duration %></span>
              </div>

              <span class="font-semibold text-yellow-600 group-hover:translate-x-1 transition">
                View Details →
              </span>

            </div>

          </a>

        </div>

      </div>

    <% }) %>

  </div>

</section>