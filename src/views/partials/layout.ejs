<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>

  <link rel="icon" href="/favicon.ico" type="image/x-icon">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-100 text-gray-900 min-h-screen">
  <%- include("navbar") %>

  <main><%- body %></main>
</body>
</html>

<div id="loginModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
  <div class="w-full max-w-md p-8 rounded-3xl border border-white/20 bg-white/10 backdrop-blur-2xl shadow-2xl">

    <div class="mb-8 text-center">
      <h2 class="text-3xl font-black text-white">Welcome Back</h2>
      <p class="mt-2 text-sm text-white/70">Login to continue your journey</p>
    </div>

    <form action="/login" method="POST" class="flex flex-col gap-4">
      <input
        name="email"
        type="email"
        required
        placeholder="Email"
        class="w-full p-3.5 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-white/50 outline-none focus:ring-2 focus:ring-yellow-400"
      >

      <input
        name="password"
        type="password"
        required
        placeholder="Password"
        class="w-full p-3.5 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-white/50 outline-none focus:ring-2 focus:ring-yellow-400"
      >

      <button class="mt-2 py-3.5 rounded-2xl bg-yellow-400 hover:bg-yellow-500 text-black font-bold transition">
        Login
      </button>
    </form>

    <p class="mt-6 text-sm text-center text-white/70">
      Don’t have an account?

      <button
        type="button"
        onclick="closeModal('loginModal'); openModal('registerModal')"
        class="font-semibold text-yellow-300 hover:text-yellow-200"
      >
        Sign Up
      </button>
    </p>

    <button
      type="button"
      onclick="closeModal('loginModal')"
      class="w-full mt-5 text-sm text-white/50 hover:text-white transition"
    >
      Cancel
    </button>
  </div>
</div>

<div id="registerModal" class="hidden fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/50 backdrop-blur-sm">
  <div class="w-full max-w-md p-8 rounded-3xl border border-white/20 bg-white/10 backdrop-blur-2xl shadow-2xl">

    <div class="mb-8 text-center">
      <h2 class="text-3xl font-black text-white">Start Your Journey</h2>
      <p class="mt-2 text-sm text-white/70">Create an account and explore the world</p>
    </div>

    <form action="/register" method="POST" class="flex flex-col gap-4">
      <input
        name="name"
        required
        placeholder="Full Name"
        class="w-full p-3.5 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-white/50 outline-none focus:ring-2 focus:ring-yellow-400"
      >

      <input
        name="email"
        type="email"
        required
        placeholder="Email"
        class="w-full p-3.5 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-white/50 outline-none focus:ring-2 focus:ring-yellow-400"
      >

      <input
        name="password"
        type="password"
        required
        placeholder="Password"
        class="w-full p-3.5 rounded-2xl bg-white/10 border border-white/10 text-white placeholder:text-white/50 outline-none focus:ring-2 focus:ring-yellow-400"
      >

      <button class="mt-2 py-3.5 rounded-2xl bg-yellow-400 hover:bg-yellow-500 text-black font-bold transition">
        Create Account
      </button>
    </form>

    <p class="mt-6 text-sm text-center text-white/70">
      Already have an account?

      <button
        type="button"
        onclick="closeModal('registerModal'); openModal('loginModal')"
        class="font-semibold text-yellow-300 hover:text-yellow-200"
      >
        Login
      </button>
    </p>

    <button
      type="button"
      onclick="closeModal('registerModal')"
      class="w-full mt-5 text-sm text-white/50 hover:text-white transition"
    >
      Cancel
    </button>
  </div>
</div>

<script>
  function openModal(id) {
    document.getElementById(id).classList.remove("hidden");
  }

  function closeModal(id) {
    document.getElementById(id).classList.add("hidden");
  }
</script>