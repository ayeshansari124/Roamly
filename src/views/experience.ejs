<main
  id="experienceRoot"
  class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10 px-6 py-8"
  data-availability='<%- JSON.stringify(experience.availability) %>'
  data-price="<%= experience.price %>"
  data-id="<%= experience._id %>"
>

  <section class="lg:col-span-2 space-y-8">

    <div>

      <img
        src="<%= experience.image %>"
        alt="<%= experience.title %>"
        class="w-full h-[360px] object-cover rounded-xl"
      >

      <h1 class="mt-6 text-2xl font-semibold"><%= experience.title %></h1>

      <p class="mt-2 max-w-2xl text-sm text-gray-600">
        <%= experience.description %>
      </p>

    </div>

    <div>

      <h3 class="mb-3 font-medium">Choose date</h3>

      <div id="dateChips" class="flex flex-wrap gap-3">

        <% Object.keys(experience.availability).forEach(date => { %>

          <button
            type="button"
            data-date="<%= date %>"
            class="date-chip px-4 py-2 text-sm border rounded-md hover:bg-gray-100"
          >
            <%= date %>
          </button>

        <% }) %>

      </div>

    </div>

    <div>

      <h3 class="mb-3 font-medium">Choose time</h3>

      <div id="timeSlots" class="flex flex-wrap gap-3 text-sm">
        <span class="text-gray-400">Select a date first</span>
      </div>

      <p class="mt-2 text-xs text-gray-400">
        All times are in IST (GMT +5:30)
      </p>

    </div>

    <div>

      <h3 class="mb-2 font-medium">About</h3>

      <p class="p-4 text-sm text-gray-600 bg-gray-50 border rounded-lg">
        <%= experience.highlights.join(", ") %>
      </p>

    </div>

  </section>

  <aside class="sticky top-24 h-fit p-6 space-y-4 bg-gray-50 border rounded-xl">

    <div class="flex justify-between text-sm text-gray-600">
      <span>Starts at</span>
      <span class="font-semibold">₹<%= experience.price %></span>
    </div>

    <div class="space-y-1 text-sm text-gray-600">

      <div class="flex justify-between">
        <span>Date</span>
        <span id="summaryDate">—</span>
      </div>

      <div class="flex justify-between">
        <span>Time</span>
        <span id="summaryTime">—</span>
      </div>

    </div>

    <div class="flex items-center justify-between pt-2 text-sm">

      <span>Quantity</span>

      <div class="flex items-center gap-2">
        <button id="qtyMinus" class="px-2 border rounded">−</button>
        <span id="qty">1</span>
        <button id="qtyPlus" class="px-2 border rounded">+</button>
      </div>

    </div>

    <hr>

    <div class="space-y-1 text-sm">

      <div class="flex justify-between">
        <span>Subtotal</span>
        <span>₹<span id="subTotal"><%= experience.price %></span></span>
      </div>

      <div class="flex justify-between">
        <span>Taxes</span>
        <span>₹59</span>
      </div>

      <div class="flex justify-between text-base font-semibold">
        <span>Total</span>
        <span>₹<span id="total"><%= experience.price + 59 %></span></span>
      </div>

    </div>

    <% if (!isAuthenticated) { %>

      <button
        disabled
        class="w-full py-3 font-medium text-gray-500 bg-gray-300 rounded-lg cursor-not-allowed"
      >
        Login Required
      </button>

    <% } else { %>

      <button
        id="confirmBtn"
        disabled
        class="w-full py-3 font-medium text-gray-500 bg-gray-300 rounded-lg cursor-not-allowed"
      >
        Confirm
      </button>

    <% } %>

  </aside>

</main>

<script defer src="/experience.js"></script>