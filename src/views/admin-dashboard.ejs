<section class="max-w-7xl mx-auto px-4 sm:px-6 py-8">

  <div class="sticky top-16 z-30 backdrop-blur-xl bg-gray-100/90 border border-white/40 rounded-[28px] p-5 sm:p-6 shadow-sm">

    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">

      <!-- LEFT -->
      <div>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-gray-900">
          📊 Admin Bookings Dashboard
        </h1>

        <p class="mt-2 text-sm sm:text-base text-gray-500">
          Monitor all bookings, revenue, payment status and customer activity.
        </p>
      </div>

      <!-- REVENUE CARD -->
      <div class="min-w-[220px] rounded-3xl bg-gradient-to-br from-green-500 to-emerald-600 text-white px-6 py-5 shadow-xl">
        <div class="text-sm font-medium text-white/80">Total Revenue</div>

        <div class="mt-2 text-3xl font-black tracking-tight">
          ₹<span id="revenueTotal">0</span>
        </div>
      </div>

    </div>

    <!-- FILTER BAR -->
    <div class="mt-7 flex flex-col xl:flex-row xl:items-center gap-4">

      <!-- FILTERS -->
      <div class="flex flex-wrap gap-2">

        <button
          data-filter="all"
          class="filter-btn active px-4 py-2 rounded-2xl bg-black text-white text-sm font-semibold transition"
        >
          All
        </button>

        <button
          data-filter="paid"
          class="filter-btn px-4 py-2 rounded-2xl bg-white border border-gray-200 text-sm font-semibold hover:bg-green-50 hover:text-green-700 transition"
        >
          Paid
        </button>

        <button
          data-filter="pending"
          class="filter-btn px-4 py-2 rounded-2xl bg-white border border-gray-200 text-sm font-semibold hover:bg-yellow-50 hover:text-yellow-700 transition"
        >
          Pending
        </button>

        <button
          data-filter="cancelled"
          class="filter-btn px-4 py-2 rounded-2xl bg-white border border-gray-200 text-sm font-semibold hover:bg-red-50 hover:text-red-700 transition"
        >
          Cancelled
        </button>

      </div>

      <!-- SEARCH -->
      <div class="flex-1 relative">

        <input
          id="searchInput"
          placeholder="Search by email or experience..."
          class="w-full rounded-2xl border border-gray-200 bg-white px-5 py-3 pl-12 outline-none focus:ring-2 focus:ring-black/10 text-sm sm:text-base"
        >

        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path stroke-linecap="round" d="m20 20-3.5-3.5"></path>
        </svg>

      </div>

      <!-- EXPORT -->
      <button
        id="exportBtn"
        class="px-5 py-3 rounded-2xl bg-yellow-400 hover:bg-yellow-500 text-black font-bold shadow-sm transition"
      >
        Export CSV
      </button>

    </div>

  </div>

  <!-- BOOKINGS GRID -->
  <div class="grid grid-cols-1 md:grid-cols-2 2xl:grid-cols-3 gap-6 mt-8">

    <% bookings.forEach(b => { %>

      <div
        class="booking-card relative overflow-hidden rounded-[28px] border border-gray-200 bg-white p-5 shadow-sm hover:shadow-2xl hover:-translate-y-1 transition duration-300 flex flex-col"
        data-payment="<%= b.paymentStatus %>"
        data-status="<%= b.status %>"
        data-email="<%= b.userId?.email?.toLowerCase() || '' %>"
        data-title="<%= b.experienceId?.title?.toLowerCase() || '' %>"
        data-date="<%= b.date %>"
        data-time="<%= b.time %>"
        data-qty="<%= b.qty %>"
        data-created="<%= new Date(b.createdAt).toLocaleDateString() %>"
        data-amount="<%= b.paymentStatus === 'paid' ? b.amountPaid : 0 %>"
      >

        <!-- TOP BADGE -->
        <div class="absolute top-4 right-4">

          <span class="px-3 py-1 rounded-full text-xs font-bold shadow-sm
            <%= b.paymentStatus === 'paid'
              ? 'bg-green-100 text-green-700'
              : 'bg-yellow-100 text-yellow-700'
            %>"
          >
            <%= b.paymentStatus.toUpperCase() %>
          </span>

        </div>

        <!-- TITLE -->
        <div class="pr-24">

          <h2 class="text-xl font-black text-gray-900 leading-snug">
            <%= b.experienceId?.title || "Deleted Experience" %>
          </h2>

          <p class="mt-2 text-sm text-gray-500 break-all">
            👤 <%= b.userId?.email || "Deleted User" %>
          </p>

        </div>

        <!-- PRICE -->
        <div class="mt-5 flex items-center justify-between">

          <div>
            <div class="text-xs uppercase tracking-wide text-gray-400 font-semibold">
              Amount
            </div>

            <div class="mt-1 text-3xl font-black text-gray-900">
              ₹<%= b.paymentStatus === 'paid' ? Number(b.amountPaid || 0) : 0 %>
            </div>
          </div>

          <!-- STATUS -->
          <span class="px-3 py-1 rounded-full text-xs font-bold
            <%= b.status === 'confirmed'
              ? 'bg-blue-100 text-blue-700'
              : 'bg-red-100 text-red-600'
            %>"
          >
            <%= b.status.toUpperCase() %>
          </span>

        </div>

        <!-- INFO GRID -->
        <div class="mt-6 grid grid-cols-2 gap-3">

          <div class="rounded-2xl bg-gray-50 p-3 border border-gray-100">
            <div class="text-[11px] uppercase tracking-wide text-gray-400 font-semibold">
              Date
            </div>

            <div class="mt-1 text-sm font-bold text-gray-800">
              📅 <%= b.date %>
            </div>
          </div>

          <div class="rounded-2xl bg-gray-50 p-3 border border-gray-100">
            <div class="text-[11px] uppercase tracking-wide text-gray-400 font-semibold">
              Time
            </div>

            <div class="mt-1 text-sm font-bold text-gray-800">
              ⏰ <%= b.time %>
            </div>
          </div>

          <div class="rounded-2xl bg-gray-50 p-3 border border-gray-100">
            <div class="text-[11px] uppercase tracking-wide text-gray-400 font-semibold">
              Quantity
            </div>

            <div class="mt-1 text-sm font-bold text-gray-800">
              👥 <%= b.qty %> People
            </div>
          </div>

          <div class="rounded-2xl bg-gray-50 p-3 border border-gray-100">
            <div class="text-[11px] uppercase tracking-wide text-gray-400 font-semibold">
              Booked On
            </div>

            <div class="mt-1 text-sm font-bold text-gray-800">
              🕒 <%= new Date(b.createdAt).toLocaleDateString() %>
            </div>
          </div>

        </div>

      </div>

    <% }) %>

  </div>

</section>

<link rel="stylesheet" href="/admin.css">
<script defer src="/admin-dashboard.js"></script>