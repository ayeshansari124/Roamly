<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Roamly — Curated Travel Experiences</title>

  <meta name="viewport" content="width=device-width, initial-scale=1">

  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <link rel="icon" href="favicon.ico" type="image/x-icon">
</head>

<body class="relative min-h-screen bg-black text-white">

  <!-- BG -->
  <div class="absolute inset-0 -z-10">

    <img
      src="https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1500&q=80"
      class="w-full h-full object-cover brightness-50"
    >

  </div>

  <!-- NAV -->
  <nav class="relative z-10 flex items-center justify-between max-w-7xl mx-auto px-6 py-6">

    <h1 class="flex items-center gap-2 text-2xl sm:text-3xl font-extrabold">
      🌍 Roamly
    </h1>

  </nav>

  <!-- HERO -->
  <section class="relative z-10 flex flex-col items-center justify-center h-[85vh] px-6 text-center">

    <h2 class="mb-6 text-4xl sm:text-6xl font-black leading-tight">
      Discover Experiences,<br class="hidden sm:block">
      Not Just Places
    </h2>

    <p class="max-w-2xl text-lg sm:text-xl opacity-90">
      Hand-picked adventures, small-group trips, and local experiences —
      curated for travelers who want more than sightseeing.
    </p>

    <div class="flex flex-wrap justify-center gap-4 mt-10">

      <button
        onclick="window.location.href='/explore'"
        class="px-7 py-3 text-lg font-bold text-black bg-yellow-400 rounded-xl hover:bg-yellow-500"
      >
        Explore Experiences
      </button>

      <button
        onclick="openModal('registerModal')"
        class="px-7 py-3 text-lg font-bold border border-white/20 rounded-xl bg-white/10 hover:bg-white/20"
      >
        Plan My Trip
      </button>

    </div>

  </section>

</body>
</html>